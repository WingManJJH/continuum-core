{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://continuum.dev/schema/v1/risk",
  "title": "Risk",
  "description": "A risk register entry that can affect many processes and systems and be mitigated by many controls (GRC building block, D45). The Phase 1 RiskControl entity stays valid and is read as a paired risk + control. LOCKED addition.",
  "type": "object",
  "required": [
    "id",
    "name",
    "likelihood",
    "impact",
    "treatment",
    "version",
    "status"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^rsk\\.[a-z0-9_.]+$"
    },
    "name": {
      "type": "string",
      "maxLength": 200
    },
    "description": {
      "type": "string",
      "maxLength": 800
    },
    "owner": {
      "type": "string",
      "maxLength": 160,
      "description": "Accountable owner: a HumanRole id (role.\u2026) or a named person/team."
    },
    "likelihood": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "impact": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "treatment": {
      "type": "string",
      "enum": [
        "mitigate",
        "accept",
        "transfer",
        "avoid"
      ]
    },
    "process_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Z]{2}\\.[0-9.]+$"
      },
      "uniqueItems": true,
      "description": "risk \u2014affects\u2192 process"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "active",
        "deprecated"
      ]
    }
  }
}
