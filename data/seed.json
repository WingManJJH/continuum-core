      "horizon": "FY2026",
      "target": {
        "statement": "Median time-to-verify under 4h with error rate <= 1%",
        "metric_value": 4,
        "metric_unit": "hours"
      },
      "kpi_refs": [
        "kpi.time_to_verify",
        "kpi.error_rate"
      ],
      "version": 2,
      "status": "active"
    },
    {
