  "KPI": [
    {
      "id": "kpi.time_to_verify",
      "name": "Median time to verify KYC",
      "formula": "median(verified_at - submitted_at) over rolling_30d",
      "unit": "hours",
      "direction": "lower_is_better",
      "target": 4,
      "live_value": 6.2,
      "as_of": "2026-08-24T00:00:00Z",
      "objective_refs": [
        "obj.reduce_onboarding_friction"
      ],
      "version": 1,
      "status": "active"
    },
    {
      "id": "kpi.error_rate",
      "name": "KYC verification error rate",
      "formula": "count(reversed)/count(verifications)*100 over rolling_30d",
      "unit": "percent",
      "direction": "lower_is_better",
      "target": 1.0,
      "live_value": 0.7,
      "as_of": "2026-08-24T00:00:00Z",
      "objective_refs": [
        "obj.reduce_onboarding_friction"
      ],
      "version": 1,
      "status": "active"
    },
    {
      "id": "kpi.expense_cycle_time",
      "name": "Expense reimbursement cycle time",
      "formula": "median(paid_at - submitted_at) over rolling_30d",
      "unit": "days",
      "direction": "lower_is_better",
      "target": 3,
      "live_value": 4.5,
      "as_of": "2026-08-24T00:00:00Z",
      "objective_refs": [
        "obj.improve_working_capital"
      ],
      "version": 1,
      "status": "active"
    },
    {
      "id": "kpi.po_cycle_time",
      "name": "Purchase-order approval cycle time",
      "formula": "median(approved_at - raised_at) over rolling_30d",
      "unit": "days",
      "direction": "lower_is_better",
      "target": 5,
      "live_value": 4.2,
      "as_of": "2026-08-24T00:00:00Z",
      "objective_refs": [
        "obj.improve_working_capital"
      ],
      "version": 1,
      "status": "active"
    },
    {
      "id": "kpi.lead_conversion",
      "name": "Inbound lead conversion rate",
      "formula": "count(converted)/count(qualified)*100 over rolling_90d",
      "unit": "percent",
      "direction": "higher_is_better",
      "target": 25,
      "live_value": 19,
      "as_of": "2026-08-24T00:00:00Z",
      "objective_refs": [
        "obj.grow_qualified_pipeline"
      ],
      "version": 1,
      "status": "active"
    },
    {
      "id": "kpi.access_review_sla",
      "name": "Access reviews completed within SLA",
      "formula": "count(in_sla)/count(reviews)*100 over rolling_30d",
      "unit": "percent",
      "direction": "higher_is_better",
      "target": 95,
      "live_value": 97,
      "as_of": "2026-08-24T00:00:00Z",
      "objective_refs": [
        "obj.strengthen_security_posture"
      ],
      "version": 1,
      "status": "active"
    },
    {
      "id": "kpi.defect_resolution_time",
      "name": "Median defect resolution time",
      "formula": "median(resolved_at - reported_at) over rolling_30d",
      "unit": "hours",
      "direction": "lower_is_better",
      "target": 48,
      "live_value": 61,
      "as_of": "2026-08-24T00:00:00Z",
      "objective_refs": [
        "obj.raise_product_quality"
      ],
      "version": 1,
      "status": "active"
    },
    {
      "id": "kpi.strategy_cycle_time",
      "name": "Annual planning cycle time",
      "formula": "plan_closed_at - plan_started_at",
      "unit": "days",
      "direction": "lower_is_better",
      "target": 30,
      "live_value": 28,
      "as_of": "2026-08-24T00:00:00Z",
      "objective_refs": [
        "obj.accelerate_strategic_planning"
      ],
      "version": 1,
      "status": "active"
    },
    {
      "id": "kpi.applicant_pass_rate",
      "name": "Applicant screen pass rate",
      "formula": "count(advanced)/count(screened)*100 over rolling_90d",
      "unit": "percent",
      "direction": "higher_is_better",
      "target": 40,
      "live_value": 35,
      "as_of": "2026-08-24T00:00:00Z",
      "objective_refs": [],
      "version": 1,
      "status": "active"
    },
    {
      "id": "kpi.unused_metric",
      "name": "Legacy metric (unreferenced)",
      "formula": "legacy_formula",
      "unit": "percent",
      "direction": "higher_is_better",
      "target": 50,
      "live_value": null,
      "as_of": "2026-08-24T00:00:00Z",
      "objective_refs": [],
      "version": 1,
      "status": "active"
    }
  ],
